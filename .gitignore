# Python bytecode
__pycache__/
*.py[cod]

# Node dependencies and build output (see ts/.gitignore for the rest)
node_modules/

# scratch output from the CLI and the test suites
out/

# runtime files the app writes next to itself; build_all.ps1 deletes these
# before packaging, so they must never be committed either
settings.json
startup.log
crash-*.txt

# Output written by capture_baseline.py when it runs the GUI selftest: renders,
# zips and a report that embed wall-clock-dependent numbers. Regenerated, never read.
_baseline_selftest/
