# Node dependencies and build output (see ts/.gitignore for the rest)
node_modules/

# scratch output from the CLI and the test suites
out/

# runtime files the app writes next to itself; scripts/build_all.ts deletes these
# before packaging, so they must never be committed either
settings.json
startup.log
crash-*.txt

# Renders, zips and a report written by the window's own selftest
# (`node ts/tests/gui.ts`). They embed wall-clock-dependent numbers and are
# regenerated on every run, so they are never committed and never read back.
# `_baseline_selftest/` was the same thing from the Python original.
_baseline_selftest/
_ts_selftest/

# Where the app writes an export before handing it to the browser.
exports/
