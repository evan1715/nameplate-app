{
  "name": "nameplate-ts",
  "version": "1.0.0",
  "description": "TypeScript port of Sean's Font Prototyping Friend \u2014 nameplate cut-file engine",
  "scripts": {
    "test": "npm run test:canonicalisation && npm run test:parity && npm run test:acceptance && npm run test:export && npm run test:fontcheck && npm run test:gui && npm run test:pairsheet && npm run test:viewmodel && npm run test:thickness && npm run test:brief && npm run test:regression && npm run test:stress",
    "build:client": "esbuild client/src/main.tsx --bundle --format=esm --platform=browser --target=es2022 --jsx=automatic --outfile=client/bundle.js --minify --sourcemap",
    "start": "npm run build:client && node src/bin/server.ts",
    "cli": "node src/bin/cli.ts",
    "brief": "node src/bin/brief.ts",
    "fontcheck": "node src/bin/fontcheck.ts",
    "test:acceptance": "node tests/acceptance.ts",
    "test:brief": "node tests/brief.ts",
    "test:canonicalisation": "node tests/canonicalisation.ts",
    "test:export": "node tests/export.ts",
    "test:fontcheck": "node tests/fontcheck.ts",
    "test:gui": "npm run build:client && node tests/gui.ts",
    "test:pairsheet": "node tests/pairsheet.ts",
    "test:parity": "node tests/parity.ts",
    "test:regression": "node tests/regression.ts",
    "test:stress": "node tests/stress.ts --font ../fonts/MerriweatherCut3Black-Engrave-v2.ttf",
    "test:thickness": "node tests/thickness.ts",
    "test:viewmodel": "node tests/viewmodel.ts",
    "typecheck": "tsc --noEmit && npm run typecheck:client",
    "typecheck:client": "tsc -p client/tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "canvaskit-wasm": "^0.41.1",
    "harfbuzzjs": "^1.5.0",
    "jsts": "^2.12.1",
    "opentype.js": "^2.0.0",
    "pako": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/opentype.js": "^1.3.10",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true
}
